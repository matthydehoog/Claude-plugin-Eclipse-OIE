<pluginMetaData path="claude-assistant">
	<name>Claude Assistant</name>
	<author>X Connections</author>
	<pluginVersion>0.2.9</pluginVersion>
	<mirthVersion>4.6.0</mirthVersion>
	<url>https://x-connections.info</url>
	<description>Chat with Claude inside the Administrator about channels, messages, errors and scripts. Message content is masked before it leaves the server, and actions such as deploying or changing scripts only run after the user approves them.</description>
	<serverClasses>
		<string>com.matthy.oie.claude.server.ClaudeServicePlugin</string>
	</serverClasses>
	<clientClasses>
		<string>com.matthy.oie.claude.client.ClaudeClientPlugin</string>
		<string>com.matthy.oie.claude.client.ClaudeSettingsPlugin</string>
	</clientClasses>
	<library type="CLIENT" path="claude-assistant-client.jar" />
	<library type="SHARED" path="claude-assistant-shared.jar" />
	<library type="SERVER" path="claude-assistant-server.jar" />
	<apiProvider type="SERVLET_INTERFACE" name="com.matthy.oie.claude.shared.ClaudeServletInterface"/>
	<apiProvider type="SERVER_CLASS" name="com.matthy.oie.claude.server.ClaudeServlet"/>
</pluginMetaData>
